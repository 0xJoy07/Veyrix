# Copy to .env beside this file. Never commit the .env file.
# Production can supply process environment variables instead; those take priority.
# Quote passwords containing spaces or #. Values are literal (no ${...} expansion).

# Shared server-to-server bearer token for /api/* routes. Use a strong random value.
# The upstream server must authenticate users before selecting a customer ID.
SHOPPING_API_KEY=
SHOPPING_HOST=127.0.0.1
SHOPPING_PORT=8000

# Groq credentials. Choose a tool-capable model available to your Groq account.
GROQ_API_KEY=
GROQ_MODEL=

SHOPPING_STORE_NAME=My Store
SHOPPING_CURRENCY=INR
SHOPPING_DELIVERY_MINOR=0
SHOPPING_POLICY=Pay on delivery only. Cancellation allowed before dispatch.
# 0 keeps memory until the session is explicitly closed/reset or the process stops.
SHOPPING_SESSION_SECONDS=0

# sqlite, postgresql, or mysql. Relative file paths resolve beside this .env file.
SHOPPING_DB_SOURCE=sqlite
SHOPPING_DB_DATABASE=state/store.db
SHOPPING_DB_HOST=localhost
SHOPPING_DB_PORT=5432
SHOPPING_DB_USERNAME=
SHOPPING_DB_PASSWORD=
SHOPPING_DB_SCHEMA=public
SHOPPING_DB_SSLMODE=require
SHOPPING_DB_SSL_CA=
SHOPPING_PRODUCT_TABLE=products
SHOPPING_PRODUCT_MAPPING={}

# PostgreSQL example: source=postgresql, database=postgres, port=5432.
# Supply your exact host/username/password; Supabase Session pooler supports IPv4.
# For MySQL choose source=mysql and port=3306.

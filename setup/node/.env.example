# Server-only credentials. Never put these in VITE_* variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Optional custom CA file; hosted Supabase uses the bundled official public CA.
DATABASE_SSL_CA=
RESEND_API_KEY=
RESEND_FROM=Veyrix <verify@YOUR_VERIFIED_DOMAIN>
# At least 32 random characters each; use different keys.
OTP_SECRET=
INTERNAL_API_KEY=
SHOPPING_API_KEY=
PYTHON_API_URL=http://127.0.0.1:8000
PORT=8001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:5174
COOKIE_SECURE=false
DELIVERY_MINOR=0

# Authoritative catalog: live views over public.products/public.reviews (no copies).
CATALOG_SOURCE=public
